<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <ui:VisualElement name="portfolio-root" class="portfolio-root">
        <ui:VisualElement class="portfolio-backdrop"/>
        <ui:VisualElement class="document-frame">
            <ui:VisualElement class="document-toolbar">
                <ui:Label text="Interactive Résumé" class="toolbar-label"/>
                <ui:Button name="close-button" text="×" tooltip="Close" class="close-button"/>
            </ui:VisualElement>
            <ui:ScrollView name="portfolio-scroll" mode="Vertical" class="document-scroll">
                <ui:VisualElement name="content-sections" class="content-stack"/>
                <ui:VisualElement class="section-card links-card">
                    <ui:Label text="Links" class="section-title"/>
                    <ui:VisualElement name="social-sections" class="link-grid"/>
                </ui:VisualElement>
                <ui:Label text="Built with Unity UI Toolkit" class="footer-label"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
