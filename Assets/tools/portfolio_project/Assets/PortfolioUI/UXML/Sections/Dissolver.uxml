<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/ShaderSettings.uss?fileID=7433441132597879392&amp;guid=40f5cee935b6a2f469d88696828a1281&amp;type=3#ShaderSettings"/>
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/DissolverSettings.uss?fileID=7433441132597879392&amp;guid=ada96979c897ee04ba047c258374ef36&amp;type=3#DissolverSettings"/>
    <ui:VisualElement name="panel-root" class="section-card shader-settings-card dissolver-settings-card">
        <ui:VisualElement class="shader-settings-header" style="justify-content: flex-start; align-items: center;">
            <ui:VisualElement class="shader-settings-heading-copy">
                <ui:VisualElement class="shader-settings-title-row" style="justify-content: space-between; align-content: auto; align-items: center;">
                    <ui:Label text="Dissolver" class="game-title shader-settings-title"/>
                    <ui:Button name="button-link" text="View project" tooltip="Open the project page" class="secondary-button shader-settings-project-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="shader-single-content">
            <ui:VisualElement class="shader-single-heading-row">
                <ui:Label text="Dissolve Settings" class="shader-tab-title"/>
            </ui:VisualElement>
            <ui:VisualElement class="shader-fields dissolver-fields">
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Edge Width" class="shader-control-label"/>
                    <ui:Slider name="slider-edge-width" low-value="0" high-value="1" value="0.05" show-input-field="true" class="shader-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Dissolve" class="shader-control-label"/>
                    <ui:Slider name="slider-dissolve" low-value="-10" high-value="10" value="0" show-input-field="true" class="shader-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Dissolve Direction" class="shader-control-label"/>
                    <ui:DropdownField name="dropdown-dissolve-direction" class="shader-dropdown"/>
                </ui:VisualElement>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Dissolve Start At" class="shader-control-label"/>
                    <ui:DropdownField name="dropdown-dissolve-start" class="shader-dropdown"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
