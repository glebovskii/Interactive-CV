<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/ShaderSettings.uss?fileID=7433441132597879392&amp;guid=40f5cee935b6a2f469d88696828a1281&amp;type=3#ShaderSettings"/>
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/SpectraShadowSettings.uss?fileID=7433441132597879392&amp;guid=3670384f7e92df74b87e6b57b8f63e01&amp;type=3#SpectraShadowSettings"/>
    <ui:VisualElement name="panel-root" class="section-card shader-settings-card spectra-shadow-settings-card" style="height: 472px;">
        <ui:VisualElement class="shader-settings-header">
            <ui:VisualElement class="shader-settings-heading-copy">
                <ui:VisualElement class="shader-settings-title-row" style="justify-content: space-evenly;">
                    <ui:Label text="Spectra Shadow" class="game-title shader-settings-title"/>
                    <ui:Button name="button-link" text="View project" tooltip="Open the project page" class="secondary-button shader-settings-project-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="shader-single-content spectra-shadow-content">
            <ui:VisualElement class="shader-single-heading-row">
                <ui:Label text="Chroma Shadow Settings" class="shader-tab-title"/>
            </ui:VisualElement>
            <ui:VisualElement class="shader-fields spectra-shadow-fields">
                <ui:Label text="Shadow Offset" class="spectra-shadow-group-title"/>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Offset X" class="shader-control-label"/>
                    <ui:Slider name="slider-shadow-offset-x" low-value="-0.1" high-value="0.1" value="0" show-input-field="true" class="shader-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Offset Y" class="shader-control-label"/>
                    <ui:Slider name="slider-shadow-offset-y" low-value="-0.1" high-value="0.1" value="0" show-input-field="true" class="shader-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="shader-control-row">
                    <ui:Label text="Offset Z" class="shader-control-label"/>
                    <ui:Slider name="slider-shadow-offset-z" low-value="-0.1" high-value="0.1" value="0" show-input-field="true" class="shader-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="spectra-shadow-color-header"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
