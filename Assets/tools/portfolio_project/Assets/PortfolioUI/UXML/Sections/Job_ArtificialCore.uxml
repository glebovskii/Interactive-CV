<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <ui:VisualElement class="section-card job-card">
        <ui:VisualElement class="section-heading-row">
            <ui:VisualElement>
                <ui:Label text="Unity Asset Integrator" class="job-role"/>
                <ui:Label text="Artificial Core" class="job-company"/>
            </ui:VisualElement>
            <ui:Label text="Sep 2024 - Feb 2026" class="job-date"/>
        </ui:VisualElement>
        <ui:VisualElement class="bullet-list">
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Integrated and optimized 3D assets while preserving visual quality across target platforms." class="bullet-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Improved texture compression, animation consistency, and VFX scalability through particle, trail, and quality-level optimization." class="bullet-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Built Unity tools that automated unit and mount creation workflows." class="bullet-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Coordinated technical requirements and aesthetic targets with art, design, and development teams." class="bullet-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
