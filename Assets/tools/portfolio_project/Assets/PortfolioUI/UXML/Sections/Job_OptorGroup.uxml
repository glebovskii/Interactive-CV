            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Optimized third-party assets using LODs, culling, billboards, and terrain segmentation." class="bullet-text"/>
            </ui:VisualElement>
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Handled asset, UI, texture, and VFX integration and optimization." class="bullet-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
