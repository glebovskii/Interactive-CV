            </ui:VisualElement>
            <ui:VisualElement class="bullet-row">
                <ui:VisualElement class="bullet-dot"/>
                <ui:Label text="Implemented sophisticated AI for large-scale army battles and compact Sudoku-style games." class="bullet-text"/>
