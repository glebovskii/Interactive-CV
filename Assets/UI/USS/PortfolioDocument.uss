.screen-space-game-panel .portfolio-pulse-button {
    scale: 1 1;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s, 0.12s, 0.55s;
    transition-timing-function: ease-out, ease-out, ease-in-out;
}

.screen-space-game-panel .portfolio-pulse-button.portfolio-pulse-button--expanded {
    scale: 1.035 1.035;
}

.screen-space-game-panel .portfolio-pulse-button:hover {
    scale: 1.055 1.055;
}

.screen-space-game-panel .portfolio-pulse-button:active {
    scale: 0.98 0.98;
}

