.link-orb {
    position: relative;
    width: 72px;
    height: 72px;
    min-width: 72px;
    min-height: 72px;
    max-width: 72px;
    max-height: 72px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-image: none;
    background-color: rgba(8, 15, 24, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(108, 221, 211, 0.68);
    border-right-color: rgba(108, 221, 211, 0.68);
    border-top-color: rgba(108, 221, 211, 0.68);
    border-bottom-color: rgba(108, 221, 211, 0.68);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.link-orb__fill-mask {
    position: relative;
    overflow: hidden;
}

.link-orb__fill {
    width: 100%;
    height: 100%;
    transform-origin: center;
    scale: 0 0;
    transition-property: scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
    background-color: rgba(77, 212, 199, 0.34);
}

.link-orb__icon {
    position: absolute;
    left: 17px;
    right: 17px;
    top: 17px;
    bottom: 17px;
    width: auto;
    height: auto;
    margin: 0;
    /* background-image: url("project://database/Assets/tools/portfolio_project/Assets/PortfolioUI/Textures/Icons/AssetStoreIcon.svg"); */
    -unity-background-scale-mode: scale-to-fit;
}
