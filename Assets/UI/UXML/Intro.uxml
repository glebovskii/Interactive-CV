<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <ui:VisualElement name="panel-root" class="section-card screen-space-panel screen-space-panel--left screen-space-panel--full-height" style="justify-content: flex-start;">
        <ui:VisualElement class="section-header" style="width: 100%; flex-shrink: 0; margin-bottom: 3%;">
            <ui:Label text="Welcome to My Interactive CV" class="section-title" style="font-size: 40px; white-space: normal; margin-bottom: 1%;">
                <Bindings>
                    <l:LocalizedString property="text" table="ui" entry="intro.title"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="Explore my experience instead of reading through it." class="game-meta" style="font-size: 23px; white-space: normal;">
                <Bindings>
                    <l:LocalizedString property="text" table="ui" entry="intro.subtitle"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="intro-content" style="flex-grow: 1; min-height: 0; justify-content: space-between;">
            <ui:Label text="This multiplayer project is an interactive alternative to a traditional résumé, built to showcase my experience through exploration rather than a static list of skills and projects." class="body-text" style="font-size: 25px; white-space: normal; flex-shrink: 0; margin-top: 0; margin-bottom: 2%;">
                <Bindings>
                    <l:LocalizedString property="text" table="ui" entry="intro.paragraph_1"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement style="flex-shrink: 0; margin-top: 1%; margin-bottom: 1%;">
                <ui:Label text="Explore the map" class="section-subtitle" style="font-size: 28px; margin-bottom: 1%;">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="intro.explore_title"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="As you explore the map, you’ll find project showcases, work experience, technical demonstrations, shader settings, external links, and other Points of Interest. Use the minimap in the upper-right corner and the directional arrow to find your next destination." class="body-text body-text--secondary" style="font-size: 25px; white-space: normal; margin-top: 0;">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="intro.paragraph_2"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement style="flex-shrink: 0; margin-top: 1%; margin-bottom: 1%;">
                <ui:Label text="Controls" class="section-subtitle" style="font-size: 28px; margin-bottom: 1%;">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="intro.controls_title"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Move with mouse/touch or keyboard—whichever feels more comfortable. Other players may be exploring alongside you, but all portfolio content can be viewed independently." class="body-text body-text--secondary" style="font-size: 25px; white-space: normal; margin-top: 0;">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="intro.paragraph_3"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:Label text="Explore in any order, interact with anything that catches your attention, and enjoy." class="body-text" style="font-size: 27px; white-space: normal; -unity-font-style: bold; flex-shrink: 0; margin-top: 2%; margin-bottom: 0;">
                <Bindings>
                    <l:LocalizedString property="text" table="ui" entry="intro.outro"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="static-overlay" picking-mode="Ignore" class="panel-static-overlay" style="background-image: url(&quot;project://database/Assets/Textures/tv_static.png?fileID=2800000&amp;guid=d272556b8e0363e449415006910500c3&amp;type=3#tv_static&quot;);"/>
    </ui:VisualElement>
</ui:UXML>
