<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/PortfolioDocument.uss?fileID=7433441132597879392&amp;guid=5b23da99a63c2b44a8c5221e25097d40&amp;type=3#PortfolioDocument"/>
    <ui:VisualElement name="panel-root" class="section-card game-card game-section-card">
        <ui:VisualElement class="game-section-gallery-hero">
            <ui:VisualElement class="game-section-gallery-item game-section-gallery-item--water">
                <ui:Label text="Water Sort" class="game-section-gallery-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="game-section-gallery-item game-section-gallery-item--sudoku">
                <ui:Label text="Sudoku" class="game-section-gallery-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="game-section-gallery-item game-section-gallery-item--war">
                <ui:Label text="War Strategy" class="game-section-gallery-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="game-section-gallery-item game-section-gallery-item--poker">
                <ui:Label text="Poker" class="game-section-gallery-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="game-section-gallery-item game-section-gallery-item--racing">
                <ui:Label text="Racing" class="game-section-gallery-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="game-copy game-section-copy">
            <ui:VisualElement class="section-heading-row game-section-heading-row">
                <ui:VisualElement class="game-section-heading-copy">
                    <ui:VisualElement class="game-section-title-role-row">
                        <ui:Label text="Optor Group" class="game-title game-section-title"/>
                        <ui:Label text="Unity Developer" class="game-section-role">
                            <Bindings>
                                <l:LocalizedString property="text" table="ui" entry="common.unity_developer"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:Label text="Optor Group · Published mobile games and prototypes" class="game-meta game-section-meta">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="optor.meta"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="game-section-heading-actions">
                    <ui:Button name="button-link" text="View projects" tooltip="Open the Optor Group developer page" class="secondary-button game-section-link-button">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="common.view_projects"/>
                            <l:LocalizedString property="tooltip" table="ui" entry="optor.tooltip"/>
                        </Bindings>
                    </ui:Button>
                    <ui:Label text="Mar 2023 – Aug 2024" class="game-section-date">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="optor.date"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="bullet-list game-section-bullet-list">
                <ui:VisualElement class="bullet-row game-section-bullet-row">
                    <ui:VisualElement class="bullet-dot game-section-bullet-dot"/>
                    <ui:Label text="Built MVPs and prototypes across puzzle, strategy, casino, and racing projects." class="bullet-text game-section-bullet-text">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="optor.bullet.prototypes"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="bullet-row game-section-bullet-row">
                    <ui:VisualElement class="bullet-dot game-section-bullet-dot"/>
                    <ui:Label text="Implemented gameplay systems, army AI, UI, and supporting production features." class="bullet-text game-section-bullet-text">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="optor.bullet.systems"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement class="bullet-row game-section-bullet-row">
                    <ui:VisualElement class="bullet-dot game-section-bullet-dot"/>
                    <ui:Label text="Integrated and optimized third-party assets using LODs, culling, billboards, texture, terrain, and VFX improvements." class="bullet-text game-section-bullet-text">
                        <Bindings>
                            <l:LocalizedString property="text" table="ui" entry="optor.bullet.assets"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="chip-row game-section-chip-row">
                <ui:Label text="Prototyping" class="chip game-section-chip">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="optor.prototyping"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Gameplay" class="chip game-section-chip">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="common.gameplay"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="AI" class="chip game-section-chip"/>
                <ui:Label text="UI" class="chip game-section-chip"/>
                <ui:Label text="Optimization" class="chip game-section-chip">
                    <Bindings>
                        <l:LocalizedString property="text" table="ui" entry="common.optimization"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="static-overlay" picking-mode="Ignore" class="panel-static-overlay"/>
    </ui:VisualElement>
</ui:UXML>
