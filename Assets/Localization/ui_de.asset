  - m_Id: 4295965595119623
    m_Localized: Projekte ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119624
    m_Localized: "Integrierte und optimierte 3D-Assets f\xFCr ein gro\xDFes Open-World-MMORPG
      und bewahrte dabei die visuelle Qualit\xE4t auf allen Plattformen."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119625
    m_Localized: "Verbesserte Texturkomprimierung, Animationskonsistenz und VFX-Performance
      \xFCber verschiedene Qualit\xE4tsstufen hinweg."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119626
    m_Localized: "Entwickelte Unity-Editor-Tools zur Automatisierung der Produktionsabl\xE4ufe
      f\xFCr Einheiten und Reittiere."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119627
    m_Localized: "Sept. 2024 \u2013 Feb. 2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119628
    m_Localized: "Offizielle Corepunk-Website \xF6ffnen"
    m_Metadata:
      m_Items: []
