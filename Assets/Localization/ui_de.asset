  - m_Id: 4295965548982272
    m_Localized: "Erstellte und ver\xF6ffentlichte das Photon-Fusion-Multiplayer-Projekt
      Art Guard."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965590925312
    m_Localized: "Ver\xF6ffentlichte Shader- und Editor-Tool-Assets im Unity Asset
      Store."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965590925313
    m_Localized: "Freiberuflicher Asset-Entwickler f\xFCr technische und visuelle
      Werkzeuge in Unity-Projekten."
