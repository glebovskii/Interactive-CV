      m_Items: []
  - m_Id: 4295965595119642
    m_Localized: "Entwickelte und verfeinerte NPC-Verhalten und Gameplay-Systeme
      f\xFCr einen Mobile-Survival-Titel."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119643
    m_Localized: Arbeitete mit Game Design zusammen, um Features zu integrieren und
      den unmittelbaren Spielfluss zu verbessern.
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119644
    m_Localized: "Behob Gameplay-Probleme und optimierte die Projektleistung auf
      unterst\xFCtzten Mobilger\xE4ten."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119645
    m_Localized: "Jan. 2022 \u2013 Dez. 2022"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119646
    m_Localized: "RetroStyle Games \xB7 Mobile-Survival"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119647
    m_Localized: Mobil
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119648
    m_Localized: "Last Pirate im App Store \xF6ffnen"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119649
    m_Localized: Integrierte und optimierte Drittanbieter-Assets mithilfe von LODs,
      Culling, Billboards sowie Verbesserungen an Texturen, Terrain und VFX.
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119650
    m_Localized: "Entwickelte MVPs und Prototypen f\xFCr Puzzle-, Strategie-, Casino-
      und Rennspielprojekte."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965599313920
    m_Localized: "Implementierte Gameplay-Systeme, Armee-KI, UI und unterst\xFCtzende
      Produktionsfunktionen."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965599313921
    m_Localized: "M\xE4rz 2023 \u2013 Aug. 2024"
    m_Metadata:
      m_Items: []
