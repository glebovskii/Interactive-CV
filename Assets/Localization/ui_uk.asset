    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119649
    m_Localized: "\u0406\u043D\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0432 \u0456
      \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0443\u0432\u0430\u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0456
      \u0430\u0441\u0435\u0442\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      LOD, culling, billboards, \u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u044C
      \u0442\u0435\u043A\u0441\u0442\u0443\u0440, terrain \u0456 VFX."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119650
    m_Localized: "\u0421\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0432 MVP \u0456
