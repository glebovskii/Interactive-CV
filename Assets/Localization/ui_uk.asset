  - m_Id: 4295965595119641
    m_Localized: "\u0423\u043A\u0440\u0430\u0457\u043D\u0441\u044C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119642
    m_Localized: "\u0420\u043E\u0437\u0440\u043E\u0431\u043B\u044F\u0432 \u0456 \u0432\u0434\u043E\u0441\u043A\u043E\u043D\u0430\u043B\u044E\u0432\u0430\u0432
      \u043F\u043E\u0432\u0435\u0434\u0456\u043D\u043A\u0443 NPC \u0442\u0430 \u0456\u0433\u0440\u043E\u0432\u0456
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u0434\u043B\u044F \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u043E\u0457
      \u0433\u0440\u0438 \u043D\u0430 \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119643
    m_Localized: "\u0421\u043F\u0456\u0432\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432
      \u0456\u0437 \u0433\u0435\u0439\u043C\u0434\u0438\u0437\u0430\u0439\u043D\u043E\u043C
      \u0434\u043B\u044F \u0456\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u0457
      \u0444\u0443\u043D\u043A\u0446\u0456\u0439 \u0456 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F
      \u0449\u043E\u043C\u043E\u043C\u0435\u043D\u0442\u043D\u043E\u0433\u043E \u0456\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u043F\u043E\u0442\u043E\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119644
    m_Localized: "\u0412\u0438\u043F\u0440\u0430\u0432\u043B\u044F\u0432 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438
