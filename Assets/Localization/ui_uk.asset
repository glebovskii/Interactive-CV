  - m_Id: 5880272751144960
    m_Localized: "\u0417\u0430\u0442\u0443\u0445\u0430\u043D\u043D\u044F \u0432\u0456\u0442\u0440\u0443
      \u0437\u0430 \u0432\u0438\u0441\u043E\u0442\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 5880272755339264
    m_Localized: "\u0421\u0438\u043B\u0430 \u0442\u0443\u0440\u0431\u0443\u043B\u0435\u043D\u0442\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 7567863393267712
    m_Localized: "\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u041F\u0440\u043E\u0454\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7604244526116864
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E
      \u0434\u043E \u043C\u043E\u0433\u043E \u0456\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      CV"
    m_Metadata:
      m_Items: []
  - m_Id: 7604372116844544
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0439\u0442\u0435
      \u043C\u0456\u0439 \u0434\u043E\u0441\u0432\u0456\u0434 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
      \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0447\u0438\u0442\u0430\u0442\u0438 \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 7604573586042880
    m_Localized: "\u0426\u0435\u0439 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0454\u0440\u043D\u0438\u0439
      \u043F\u0440\u043E\u0454\u043A\u0442 \u2014 \u0456\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u0430
      \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043D\u043E\u043C\u0443
      \u0440\u0435\u0437\u044E\u043C\u0435, \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438
      \u043C\u0456\u0439 \u0434\u043E\u0441\u0432\u0456\u0434 \u0447\u0435\u0440\u0435\u0437
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F \u0441\u0432\u0456\u0442\u0443,
      \u0430 \u043D\u0435 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0439
      \u0441\u0442\u0430\u0442\u0438\u0447\u043D\u0438\u0439 \u0441\u043F\u0438\u0441\u043E\u043A
      \u043D\u0430\u0432\u0438\u0447\u043E\u043A \u0456 \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 7604841019060224
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u044E\u0447\u0438
      \u043C\u0430\u043F\u0443, \u0432\u0438 \u0437\u043D\u0430\u0439\u0434\u0435\u0442\u0435
      \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0456\u0457 \u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432,
      \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E \u043F\u0440\u043E
      \u0434\u043E\u0441\u0432\u0456\u0434 \u0440\u043E\u0431\u043E\u0442\u0438,
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u0457,
      \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0448\u0435\u0439\u0434\u0435\u0440\u0456\u0432,
      \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456 \u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F
      \u0442\u0430 \u0456\u043D\u0448\u0456 \u0442\u043E\u0447\u043A\u0438 \u0456\u043D\u0442\u0435\u0440\u0435\u0441\u0443.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u043C\u0456\u043D\u0456\u043C\u0430\u043F\u0443 \u0443 \u043F\u0440\u0430\u0432\u043E\u043C\u0443
      \u0432\u0435\u0440\u0445\u043D\u044C\u043E\u043C\u0443 \u043A\u0443\u0442\u0456
      \u0442\u0430 \u0441\u0442\u0440\u0456\u043B\u043A\u0443-\u043D\u0430\u0432\u0456\u0433\u0430\u0442\u043E\u0440,
      \u0449\u043E\u0431 \u0437\u043D\u0430\u0439\u0442\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0443
      \u0446\u0456\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7604940742832128
    m_Localized: "\u041A\u0435\u0440\u0443\u0439\u0442\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u043C
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u043C\u0438\u0448\u0456/\u0434\u043E\u0442\u0438\u043A\u0443
      \u0430\u0431\u043E \u043A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0438
      \u2014 \u044F\u043A \u0432\u0430\u043C \u0437\u0440\u0443\u0447\u043D\u0456\u0448\u0435.
      \u0406\u043D\u0448\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0432\u0430\u0442\u0438 \u043C\u0430\u043F\u0443
      \u0440\u0430\u0437\u043E\u043C \u0456\u0437 \u0432\u0430\u043C\u0438, \u0430\u043B\u0435
      \u0432\u0435\u0441\u044C \u0432\u043C\u0456\u0441\u0442 \u043F\u043E\u0440\u0442\u0444\u043E\u043B\u0456\u043E
      \u043C\u043E\u0436\u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0442\u0438
      \u043D\u0435\u0437\u0430\u043B\u0435\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 7605041779421184
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0439\u0442\u0435
      \u0432\u0441\u0435 \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443, \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u0439\u0442\u0435
      \u0437 \u0442\u0438\u043C, \u0449\u043E \u043F\u0440\u0438\u0432\u0435\u0440\u0442\u0430\u0454
      \u0443\u0432\u0430\u0433\u0443, \u0456 \u043F\u0440\u0438\u0454\u043C\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 7606851353161728
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0439\u0442\u0435
      \u043C\u0430\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 7606904411107328
    m_Localized: "\u041A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
