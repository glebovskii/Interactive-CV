      m_Items: []
  - m_Id: 4297784589266944
    m_Localized: "\u2014 \u0420\u043E\u0437\u0440\u043E\u0431\u043D\u0438\u043A Unity"
    m_Metadata:
      m_Items: []
  - m_Id: 4297784593461248
    m_Localized: "\u041C\u043E\u0431\u0456\u043B\u044C\u043D\u0456 \u0456\u0433\u0440\u0438
      \xB7 \u0413\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0438, \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457,
      \u043A\u0430\u0437\u0438\u043D\u043E \u0442\u0430 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4297784593461249
    m_Localized: "\u0421\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0432 MVP \u0456
      \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0438 \u0432 \u0436\u0430\u043D\u0440\u0430\u0445
      \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043E\u043A, \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439,
      \u043A\u0430\u0437\u0438\u043D\u043E \u0442\u0430 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 4297784593461250
    m_Localized: "\u0420\u0435\u0430\u043B\u0456\u0437\u0443\u0432\u0430\u0432 \u0456\u0433\u0440\u043E\u0432\u0456
      \u0441\u0438\u0441\u0442\u0435\u043C\u0438, AI \u0434\u043B\u044F \u0432\u0435\u043B\u0438\u043A\u0438\u0445
      \u0430\u0440\u043C\u0456\u0439 \u0456 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0456
      \u0456\u0433\u0440\u0438 \u0432 \u0441\u0442\u0438\u043B\u0456 Sudoku."
    m_Metadata:
      m_Items: []
  - m_Id: 4297784593461251
    m_Localized: "\u041E\u043F\u0442\u0438\u043C\u0456\u0437\u0443\u0432\u0430\u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0456 \u0430\u0441\u0435\u0442\u0438
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E LOD, culling,
      billboards \u0456 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u0446\u0456\u0457
      \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4297784593461252
    m_Localized: "\u0412\u0438\u043A\u043E\u043D\u0443\u0432\u0430\u0432 \u0456\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044E
      \u0439 \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0430\u0446\u0456\u044E \u0430\u0441\u0435\u0442\u0456\u0432,
      UI, \u0442\u0435\u043A\u0441\u0442\u0443\u0440 \u0456 VFX \u0443 \u0440\u0456\u0437\u043D\u0438\u0445
      \u043F\u0440\u043E\u0454\u043A\u0442\u0430\u0445."
