      \u0442\u0430 \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0443\u0432\u0430\u0432
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      \u043F\u0440\u043E\u0454\u043A\u0442\u0443 \u043D\u0430 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043D\u0438\u0445
      \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0438\u0445 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119645
    m_Localized: "\u0441\u0456\u0447. 2022 \u2013 \u0433\u0440\u0443\u0434. 2022"
