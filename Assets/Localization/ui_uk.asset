    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119623
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
      \u043F\u0440\u043E\u0454\u043A\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119624
    m_Localized: "\u0406\u043D\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0432 \u0456
      \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0443\u0432\u0430\u0432 3D-\u0430\u0441\u0435\u0442\u0438
      \u0434\u043B\u044F \u0432\u0435\u043B\u0438\u043A\u043E\u0457 MMORPG \u0437
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u043C \u0441\u0432\u0456\u0442\u043E\u043C,
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044E\u0447\u0438 \u0432\u0456\u0437\u0443\u0430\u043B\u044C\u043D\u0443
      \u044F\u043A\u0456\u0441\u0442\u044C \u043D\u0430 \u0440\u0456\u0437\u043D\u0438\u0445
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119625
    m_Localized: "\u041F\u043E\u043A\u0440\u0430\u0449\u0438\u0432 \u0441\u0442\u0438\u0441\u043D\u0435\u043D\u043D\u044F
      \u0442\u0435\u043A\u0441\u0442\u0443\u0440, \u0443\u0437\u0433\u043E\u0434\u0436\u0435\u043D\u0456\u0441\u0442\u044C
      \u0430\u043D\u0456\u043C\u0430\u0446\u0456\u0439 \u0456 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u0456\u0441\u0442\u044C
      VFX \u043D\u0430 \u0440\u0456\u0437\u043D\u0438\u0445 \u0440\u0456\u0432\u043D\u044F\u0445
      \u044F\u043A\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965595119626
    m_Localized: "\u0420\u043E\u0437\u0440\u043E\u0431\u0438\u0432 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438
