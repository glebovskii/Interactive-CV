    m_Metadata:
      m_Items: []
  - m_Id: 4295965603508233
    m_Localized: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u043A\u043E\u043B\u044C\u043E\u0440\u043E\u0432\u0438\u0445 \u0442\u0456\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965603508234
    m_Localized: "\u0417\u043C\u0456\u0449\u0435\u043D\u043D\u044F \u0442\u0456\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 4295965603508235
    m_Localized: "\u0420\u043E\u0437\u0440\u043E\u0431\u043D\u0438\u043A Unity \u0456\u0437
      \u043F\u043E\u043D\u0430\u0434 4 \u0440\u043E\u043A\u0430\u043C\u0438 \u0434\u043E\u0441\u0432\u0456\u0434\u0443
      \u043A\u0440\u043E\u0441\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u043D\u043E\u0457
      \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438 \u0456\u0433\u043E\u0440.
      \u0421\u043F\u0435\u0446\u0456\u0430\u043B\u0456\u0437\u0443\u044E\u0441\u044F
      \u043D\u0430 \u0456\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u0457 \u0430\u0441\u0435\u0442\u0456\u0432,
      \u043E\u043F\u0442\u0438\u043C\u0456\u0437\u0430\u0446\u0456\u0457 \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0443
      \u0442\u0430 \u043F\u0430\u043C\u2019\u044F\u0442\u0456, \u043F\u0440\u043E\u0446\u0435\u0441\u0430\u0445
      \u0442\u0435\u0445\u043D\u0456\u0447\u043D\u043E\u0433\u043E \u0430\u0440\u0442\u0443
      \u0439 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u0445
      \u0434\u043B\u044F \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965603508236
    m_Localized: "\u0414\u043E\u0441\u0432\u0456\u0434 \u043E\u0445\u043E\u043F\u043B\u044E\u0454
      \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u0443 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0443
      \u0444\u0443\u043D\u043A\u0446\u0456\u0439 \u0456 \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0438\u0445
      \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0456\u0432, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u043E PC-\u043F\u0440\u043E\u0454\u043A\u0442\u0456\u0432
      \u0443 \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u0445.
      \u041E\u043F\u0443\u0431\u043B\u0456\u043A\u0443\u0432\u0430\u0432 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438
      Unity, \u0448\u0435\u0439\u0434\u0435\u0440\u043D\u0456 \u0430\u0441\u0435\u0442\u0438
      \u0442\u0430 \u0431\u0430\u0433\u0430\u0442\u043E\u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044C\u043A\u0443
      \u0433\u0440\u0443 Art Guard."
    m_Metadata:
      m_Items: []
  - m_Id: 4295965603508237
    m_Localized: "\u041F\u0440\u043E\u0444\u0435\u0441\u0456\u0439\u043D\u0438\u0439
      \u043F\u0440\u043E\u0444\u0456\u043B\u044C"
    m_Metadata:
      m_Items: []
